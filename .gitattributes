# Auto detect text files and perform LF normalization
* text=auto

# The starter kit keeps its bytes: the catalogue records the SHA-256 of each file.
kit/** -text

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# The profiles of board makers keep their bytes as they are on every platform.
config/dfm_*.cfg -text
config/dfm/*.cfg -text
