#usage "Splits, measures and joins texts, and takes a file name apart"
// An example written for this project; it needs no design.
string list = "resistor,capacitor,inductor";
string words[];
int count = strsplit(words, list, ",");
printf("%d words\n", count);
for (int i = 0; i < count; i++) {
  printf("%d %-10s %2d %s\n", i + 1, words[i], strlen(words[i]), strupr(strsub(words[i], 0, 3)));
}
string path = "C:/work/designs/board_v2.brd";
printf("%s | %s | %s | %s\n", filedir(path), filename(path), fileext(path), filesetext(path, ".json"));
string line;
sprintf(line, "%s has %d chars", strjoin(words, "+"), strlen(strjoin(words, "+")));
printf("%s\n", line);
printf("r first at %d, r last at %d, ind at %d, xyz at %d\n",
       strchr(list, 'r'), strrchr(list, 'r'), strstr(list, "ind"), strstr(list, "xyz"));
printf("%d %f\n", strtol("  42 apples"), strtod("2.5e1kg"));
