<?xml version="1.0" encoding="utf-8"?>
<!-- EH3D-PHOENIX-PCB starter kit. SPDX-License-Identifier: GPL-3.0-or-later. Own work, not verified. -->
<eagle version="9.6.2">
<drawing>
<settings/>
<layers>
<layer number="1" name="Top" color="1" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="1" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="1" fill="1" visible="yes" active="yes"/>
<layer number="22" name="bPlace" color="1" fill="1" visible="yes" active="yes"/>
<layer number="29" name="tStop" color="1" fill="1" visible="yes" active="yes"/>
<layer number="30" name="bStop" color="1" fill="1" visible="yes" active="yes"/>
<layer number="31" name="tCream" color="1" fill="1" visible="yes" active="yes"/>
<layer number="32" name="bCream" color="1" fill="1" visible="yes" active="yes"/>
<layer number="51" name="tDocu" color="1" fill="1" visible="yes" active="yes"/>
<layer number="52" name="bDocu" color="1" fill="1" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="25" y2="0" width="0.1" layer="20"/>
<wire x1="25" y1="0" x2="25" y2="15" width="0.1" layer="20"/>
<wire x1="25" y1="15" x2="0" y2="15" width="0.1" layer="20"/>
<wire x1="0" y1="15" x2="0" y2="0" width="0.1" layer="20"/>
</plain>
<libraries>
<library name="eh3d-kit">
<packages>
<package name="HDR-1X02">
<pad name="1" x="-1.27" y="0" drill="1" diameter="1.7" shape="square"/>
<pad name="2" x="1.27" y="0" drill="1" diameter="1.7"/>
</package>
<package name="CHIP-0805">
<smd name="1" x="-0.95" y="0" dx="1.15" dy="1.45" layer="1"/>
<smd name="2" x="0.95" y="0" dx="1.15" dy="1.45" layer="1"/>
</package>
<package name="LED-0805">
<smd name="1" x="-0.95" y="0" dx="1.15" dy="1.45" layer="1"/>
<smd name="2" x="0.95" y="0" dx="1.15" dy="1.45" layer="1"/>
</package>
</packages>
</library>
</libraries>
<designrules name="eh3d-kit">
<param name="mdWireWire" value="0.15mm"/>
<param name="mdWirePad" value="0.15mm"/>
<param name="mdWireVia" value="0.15mm"/>
<param name="mdPadPad" value="0.15mm"/>
<param name="mdPadVia" value="0.15mm"/>
<param name="mdViaVia" value="0.15mm"/>
<param name="mdSmdPad" value="0.15mm"/>
<param name="mdSmdVia" value="0.15mm"/>
<param name="mdSmdSmd" value="0.15mm"/>
<param name="mdCopperDimension" value="0.3mm"/>
<param name="mdDrill" value="0.25mm"/>
<param name="msWidth" value="0.15mm"/>
<param name="msDrill" value="0.3mm"/>
<param name="rlMinPadTop" value="0.15mm"/>
<param name="rlMinPadBottom" value="0.15mm"/>
<param name="rlMinViaOuter" value="0.15mm"/>
</designrules>
<elements>
<element name="J1" library="eh3d-kit" package="HDR-1X02" value="PWR" x="4" y="7.5" rot="R90"/>
<element name="R1" library="eh3d-kit" package="CHIP-0805" value="1k" x="11" y="10"/>
<element name="D1" library="eh3d-kit" package="LED-0805" value="GREEN" x="18" y="6"/>
</elements>
<signals>
<signal name="VCC">
<contactref element="J1" pad="1"/>
<contactref element="R1" pad="1"/>
<wire x1="10.05" y1="10" x2="9.5" y2="9.75" width="0.4" layer="1"/>
<wire x1="9.5" y1="9.75" x2="7.5" y2="9.75" width="0.4" layer="1"/>
<wire x1="7.5" y1="9.75" x2="4.5" y2="6.75" width="0.4" layer="1"/>
<wire x1="4.5" y1="6.75" x2="4" y2="6.23" width="0.4" layer="1"/>
</signal>
<signal name="LEDA">
<contactref element="R1" pad="2"/>
<contactref element="D1" pad="2"/>
<wire x1="18.95" y1="6" x2="18.5" y2="6.5" width="0.4" layer="1"/>
<wire x1="18.5" y1="6.5" x2="15.5" y2="9.5" width="0.4" layer="1"/>
<wire x1="15.5" y1="9.5" x2="12.5" y2="9.5" width="0.4" layer="1"/>
<wire x1="12.5" y1="9.5" x2="11.95" y2="10" width="0.4" layer="1"/>
</signal>
<signal name="GND">
<contactref element="D1" pad="1"/>
<contactref element="J1" pad="2"/>
<via x="15.75" y="6.5" extent="1-16" drill="0.4" diameter="0.8"/>
<wire x1="4" y1="8.77" x2="4.5" y2="8.5" width="0.4" layer="16"/>
<wire x1="4.5" y1="8.5" x2="13.75" y2="8.5" width="0.4" layer="16"/>
<wire x1="13.75" y1="8.5" x2="15.75" y2="6.5" width="0.4" layer="16"/>
<wire x1="15.75" y1="6.5" x2="16.5" y2="6.5" width="0.4" layer="1"/>
<wire x1="16.5" y1="6.5" x2="17.05" y2="6" width="0.4" layer="1"/>
</signal>
</signals>
</board>
</drawing>
</eagle>
